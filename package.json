{
  "name": "toon-ui-monorepo",
  "private": true,
  "version": "2.1.4",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:playground": "pnpm --dir apps/playground dev",
    "lint": "turbo run lint",
    "release:verify": "pnpm build && pnpm typecheck && pnpm test",
    "release:check": "pnpm build && pnpm typecheck && pnpm test",
    "release:publish": "pnpm release:verify && pnpm publish:all",
    "release": "pnpm release:publish",
    "publish:core": "pnpm --filter @toon-ui/core publish --access public --no-git-checks",
    "publish:react": "pnpm --filter @toon-ui/react publish --access public --no-git-checks",
    "publish:all": "pnpm publish:core && pnpm publish:react",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6",
    "zod": "^4.4.3"
  }
}
