{
  "name": "@toon-ui/toon-ui",
  "version": "1.1.0",
  "description": "Main public entrypoint for ToonUI, a semantic UI runtime for AI-native apps.",
  "keywords": [
    "toon-ui",
    "ai",
    "react",
    "chat",
    "ui",
    "conversational-ui"
  ],
  "homepage": "https://github.com/jefferson-lopez/toon-ui#readme",
  "bugs": {
    "url": "https://github.com/jefferson-lopez/toon-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jefferson-lopez/toon-ui.git",
    "directory": "packages/toon-ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets/basic": {
      "types": "./dist/presets/basic.d.ts",
      "default": "./dist/presets/basic.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@toon-ui/core": "workspace:1.1.0",
    "@toon-ui/react": "workspace:1.1.0"
  },
  "peerDependencies": {
    "react": "^19.2.6"
  }
}
