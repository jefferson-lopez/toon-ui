{
  "name": "@toon-ui/toon-ui",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./presets/shadcn": {
      "types": "./dist/presets/shadcn.d.ts",
      "default": "./dist/presets/shadcn.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@toon-ui/core": "workspace:*",
    "@toon-ui/react": "workspace:*",
    "@toon-ui/shadcn": "workspace:*"
  }
}
